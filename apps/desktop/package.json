{
  "name": "@fragmemo/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Fragmemo for macOS",
  "author": "m1inato",
  "homepage": "https://github.com/m1inato/Fragmemo",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --mac --publish never",
    "dist:dir": "electron-vite build && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@fragmemo/core": "workspace:*",
    "@fragmemo/ui": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "kuromoji": "^0.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.16.0",
    "typescript": "5.9.3",
    "vite": "^8.3.8"
  }
}
